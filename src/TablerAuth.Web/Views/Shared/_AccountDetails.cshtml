@model TablerAuth.Application.Auth.SignedInUserInfo

<div class="row row-cards">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Hesap</h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Ad</div>
                        <div class="datagrid-content">@(string.IsNullOrWhiteSpace(Model.DisplayName) ? "—" : Model.DisplayName)</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">E-posta</div>
                        <div class="datagrid-content">@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Roller</div>
                        <div class="datagrid-content">
                            @if (Model.Roles.Count == 0)
                            {
                                <span class="text-secondary">—</span>
                            }
                            else
                            {
                                foreach (var role in Model.Roles)
                                {
                                    <span class="badge bg-blue-lt">@role</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">İzinler</div>
                        <div class="datagrid-content">
                            @if (Model.Permissions.Count == 0)
                            {
                                <span class="text-secondary">Bu rol izin vermez</span>
                            }
                            else
                            {
                                foreach (var permission in Model.Permissions)
                                {
                                    <span class="badge bg-azure-lt">@permission</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Bu hesapta şifre</div>
                        <div class="datagrid-content">@(Model.HasPassword ? "Evet" : "Hayır — bağlı bir sağlayıcıyla girin")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Bu oturum</h3>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center">
                    @if (Model.CurrentSignIn.IsExternal)
                    {
                        <partial name="_ExternalProviderIcon" model="Model.CurrentSignIn.Scheme" />
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-2 me-2" aria-hidden="true" focusable="false"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>
                    }
                    <div>
                        <div class="fw-bold">@Model.CurrentSignIn.DisplayName</div>
                        <div class="text-secondary small">Bu kez böyle giriş yaptınız.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">Giriş yöntemleri</h3>
    </div>
    @if (Model.LinkedMethods.Count == 0)
    {
        <div class="card-body">
            <p class="text-secondary mb-0">Henüz bağlı bir giriş yöntemi yok.</p>
        </div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var method in Model.LinkedMethods)
            {
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            @if (method.IsExternal)
                            {
                                <partial name="_ExternalProviderIcon" model="method.Scheme" />
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-2 me-2" aria-hidden="true" focusable="false"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>
                            }
                        </div>
                        <div class="col">
                            <div class="fw-bold">@method.DisplayName</div>
                            <div class="text-secondary small">
                                @(method.IsExternal ? $"Bağlı {method.DisplayName} hesabı" : "Yerel e-posta ve şifre")
                            </div>
                        </div>
                        <div class="col-auto">
                            @if (method.UsedThisSession)
                            {
                                <span class="badge bg-green-lt">Bu oturumda kullanıldı</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Bağlı</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
