@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["Pretitle"] = "Something went wrong";
}

<div class="card">
    <div class="card-body">
        <p class="text-secondary">An error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p class="mb-0">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }
    </div>
</div>
