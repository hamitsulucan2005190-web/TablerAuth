@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
    ViewData["Pretitle"] = "Bir şeyler ters gitti";
}

<div class="card">
    <div class="card-body">
        <p class="text-secondary">İsteğiniz işlenirken bir hata oluştu.</p>
        @if (Model.ShowRequestId)
        {
            <p class="mb-0">
                <strong>İstek kimliği:</strong> <code>@Model.RequestId</code>
            </p>
        }
    </div>
</div>
