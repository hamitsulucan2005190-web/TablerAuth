@model IReadOnlyList<TablerAuth.Application.IdentityProviders.IdentityProviderListItem>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Giriş sağlayıcıları";
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary">
        Sağlayıcı ekle
    </a>
}

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success alert-dismissible" role="status">
        <div class="d-flex">
            <div>@statusMessage</div>
        </div>
        <a class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></a>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <h3 class="card-title">Bu sayfa ne işe yarar</h3>
        <p class="text-secondary mb-2">
            İnsanlar e-posta ve şifreyle veya Google gibi dış bir hesapla girebilir.
            Bu sayfada giriş ekranında hangi ekstra düğmelerin görüneceğine karar verirsiniz.
        </p>
        <ul class="text-secondary mb-0">
            <li><strong>Giriş sayfasında</strong> — düğme görünür, o hizmet kullanılabilir.</li>
            <li><strong>Kapalı</strong> — düğme gizlenir, o giriş yolu kapanır.</li>
        </ul>
        <p class="text-secondary mb-0 mt-2">
            Buradaki satır tek başına yetmez. Google, GitHub ve LinkedIn’in her birinin uygulamada eşleşen işleyicisi vardır.
            Genel OpenID Connect dördüncü bir işleyici türüdür; ayrıca Authority adresi ister.
        </p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="card-body">
            <div class="empty">
                <p class="empty-title">Henüz giriş sağlayıcısı yok</p>
                <p class="empty-subtitle text-secondary">
                    Sağlayıcılar veritabanında tutulur. Buradan ekleyin veya uygulama ilk açılışta Google, GitHub ve LinkedIn’i doldursun.
                </p>
                <div class="empty-action">
                    <a asp-action="Create" class="btn btn-primary">Sağlayıcı ekle</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row row-cards">
        @foreach (var provider in Model)
        {
            var returnUrls = new List<string>
            {
                $"{Context.Request.Scheme}://{Context.Request.Host}{provider.CallbackPath}"
            };
            if (HostEnvironment.IsDevelopment())
            {
                foreach (var extra in new[]
                         {
                             $"https://localhost:7258{provider.CallbackPath}",
                             $"http://localhost:5059{provider.CallbackPath}"
                         })
                {
                    if (!returnUrls.Contains(extra, StringComparer.OrdinalIgnoreCase))
                    {
                        returnUrls.Add(extra);
                    }
                }
            }
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex align-items-center">
                            <partial name="_ExternalProviderIcon" model="provider.Scheme" />
                            <div>
                                <h3 class="card-title mb-0">@provider.DisplayName</h3>
                                <div class="text-secondary small">
                                    Giriş düğmesi: @provider.DisplayName ile giriş yap
                                    @if (!string.Equals(provider.Kind, provider.DisplayName, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span> · Tür: @provider.Kind</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-actions d-flex align-items-center gap-2">
                            @if (provider.IsActive)
                            {
                                <span class="badge bg-green-lt">Giriş sayfasında</span>
                            }
                            else if (provider.Enabled)
                            {
                                <span class="badge bg-yellow-lt">Açık, henüz hazır değil</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Kapalı</span>
                            }
                            <form asp-action="SetEnabled" method="post">
                                <input type="hidden" name="id" value="@provider.Id" />
                                <input type="hidden" name="enabled" value="@((!provider.Enabled).ToString().ToLowerInvariant())" />
                                <button type="submit"
                                        class="btn btn-sm @(provider.Enabled ? "btn-outline-danger" : "btn-outline-success")"
                                        title="@(provider.Enabled ? "Bu düğmeyi giriş sayfasında gizle" : "Bu düğmeyi giriş sayfasında göster")">
                                    @(provider.Enabled ? "Kapat" : "Aç")
                                </button>
                            </form>
                            <div class="dropdown">
                                <a href="#" class="btn btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    Daha fazla
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@provider.Id">Ayarları düzenle</a>
                                    <form asp-action="Delete" method="post"
                                          onsubmit="return confirm('@provider.DisplayName bu listeden kaldırılsın mı? Sağlayıcının kendi uygulaması (örneğin Google Cloud) silinmez.');">
                                        <input type="hidden" name="id" value="@provider.Id" />
                                        <button type="submit" class="dropdown-item text-danger">Listeden kaldır</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table">
                            <tbody>
                                <tr>
                                    <td class="text-secondary w-25">Uygulama kimliği</td>
                                    <td>
                                        <code>@provider.ClientIdPreview</code>
                                        <div class="text-secondary small">
                                            Sağlayıcının geliştirici konsolundaki herkese açık kimlik. Burada göstermek güvenlidir.
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-secondary">Gizli</td>
                                    <td>
                                        @if (provider.HasClientSecret)
                                        {
                                            <span class="badge bg-green-lt">Güvenle saklandı</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-red-lt">Bulunamadı</span>
                                        }
                                        <div class="text-secondary small">
                                            Gizlinin kendisi bu tabloda asla tutulmaz.
                                            Uygulama onu User Secrets, ortam değişkeni veya Key Vault’tan
                                            <code>@provider.ClientSecretKey</code> anahtarıyla okur.
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-secondary">Dönüş adresi</td>
                                    <td>
                                        @foreach (var returnUrl in returnUrls)
                                        {
                                            <div class="d-flex align-items-start gap-2 flex-wrap mb-1">
                                                <code class="js-copy-source">@returnUrl</code>
                                                <button type="button" class="btn btn-sm js-copy" data-copy="@returnUrl">Kopyala</button>
                                            </div>
                                        }
                                        <div class="text-secondary small">
                                            Biri erişimi onayladıktan sonra sağlayıcı onu buraya gönderir.
                                            Gerçekten kullandığınız her adresi kaydedin (Safari çoğu zaman 5059, Chrome 7258 kullanır).
                                        </div>
                                    </td>
                                </tr>
                                @if (!string.IsNullOrWhiteSpace(provider.Scopes))
                                {
                                    <tr>
                                        <td class="text-secondary">Kullanıcıdan istenenler</td>
                                        <td>
                                            <code>@provider.Scopes</code>
                                            <div class="text-secondary small">
                                                Giriş sırasında bu uygulamanın istediği profil bilgileri.
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(provider.Warning))
                    {
                        <div class="card-footer">
                            <div class="alert alert-warning mb-0" role="status">
                                @provider.Warning
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
