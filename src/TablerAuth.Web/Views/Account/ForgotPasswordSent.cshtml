@model ForgotPasswordSentViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "E-postanızı kontrol edin";
}

<div class="card card-md">
    <div class="card-body">
        <h2 class="h2 text-center mb-3">Bu adresi kontrol edin</h2>
        <p class="text-secondary text-center mb-0">
            <strong>@Model.Email</strong> kayıtlıysa sıfırlama bağlantısı oraya gönderildi.
            Gelen kutusu ve Spam klasörüne bakın, sonra bağlantıyı açıp yeni şifre belirleyin.
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.DevelopmentResetUrl))
        {
            @if (!Model.DevelopmentEmailSent)
            {
                <div class="alert alert-warning mt-4" role="status">
                    Gmail iletisi bu makineden çıkmadı (SMTP başarısız). Aşağıdaki yedek bağlantıyı kullanın. SMTP çalıştıktan sonra Spam klasörünü de kontrol edin.
                </div>
            }
            <div class="alert alert-info mt-4" role="status">
                <div class="mb-2">Yalnızca geliştirme — hesap bu makinede olduğu için yedek bağlantı. Önce e-postayı tercih edin; bu bir yedektir. Jeton günlüğe yazılmaz.</div>
                <a class="btn btn-primary w-100" href="@Model.DevelopmentResetUrl">Yeni şifre belirle</a>
            </div>
        }
    </div>
</div>

<div class="text-center text-secondary mt-3">
    <a asp-controller="Account" asp-action="Login">Girişe dön</a>
</div>
