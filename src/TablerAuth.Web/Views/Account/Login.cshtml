@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Giriş yap";
    ViewData["ReturnUrl"] = Model.ReturnUrl;
}

<div class="card card-md">
    <div class="card-body">
        <h2 class="h2 text-center mb-4">Hesabınıza giriş yapın</h2>

        @if (Context.Request.Query["reset"] == "1")
        {
            <div class="alert alert-success" role="status">Şifreniz güncellendi. Yeni şifreyle giriş yapın.</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="sizin@eposta.com" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <div class="form-label">
                    <label asp-for="Password">Şifre</label>
                    <span class="form-label-description">
                        <a asp-controller="Account" asp-action="ForgotPassword">Şifremi unuttum</a>
                    </span>
                </div>
                <div class="input-group input-group-flat">
                    <input asp-for="Password" class="form-control" placeholder="Şifreniz" autocomplete="current-password" />
                    <span class="input-group-text">
                        <a href="#" class="link-secondary js-password-toggle" title="Şifreyi göster" aria-label="Şifreyi göster" aria-pressed="false">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1 js-password-show"><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1 d-none js-password-hide"><path d="M10.585 10.587a2 2 0 0 0 2.829 2.83" /><path d="M16.681 16.673a8.717 8.717 0 0 1 -4.681 1.327c-3.6 0 -6.6 -2 -9 -6c1.272 -2.12 2.712 -3.678 4.32 -4.674m2.86 -1.146a9.055 9.055 0 0 1 1.82 -.18c3.6 0 6.6 2 9 6c-.666 1.11 -1.379 2.067 -2.138 2.87" /><path d="M3 3l18 18" /></svg>
                        </a>
                    </span>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
                <div class="form-hint">Kayıt olurken seçtiğiniz şifre — Google hesap şifreniz değil. Sonra Giriş yap’a basın, Google düğmesine değil.</div>
            </div>

            <div class="mb-2">
                <label class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <span class="form-check-label">Bu cihazda beni hatırla</span>
                </label>
                <div class="form-hint">14 gün boyunca oturumunuz açık kalır. İşaretlemezseniz tarayıcıyı kapatınca çıkış yapılır.</div>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
            </div>
        </form>
    </div>

    <partial name="_ExternalLoginButtons" model="Model.ExternalProviders" />
</div>

<div class="text-center text-secondary mt-3">
    Henüz hesabınız yok mu? <a asp-controller="Account" asp-action="Register">Kayıt ol</a>
</div>
