@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}

<div class="card card-md">
    <div class="card-body">
        <h2 class="h2 text-center mb-4">Login to your account</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="your@email.com" autocomplete="username" />
            </div>

            <div class="mb-2">
                <label class="form-label" asp-for="Password">
                    Password
                    <span class="form-label-description">
                        <a asp-controller="Account" asp-action="ForgotPassword">I forgot password</a>
                    </span>
                </label>
                <div class="input-group input-group-flat">
                    <input asp-for="Password" class="form-control" placeholder="Your password" autocomplete="current-password" />
                    <span class="input-group-text">
                        <a href="#" class="link-secondary js-password-toggle" title="Show password" data-bs-toggle="tooltip" aria-label="Show password">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1"><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                        </a>
                    </span>
                </div>
            </div>

            <div class="mb-2">
                <label class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <span class="form-check-label">Remember me on this device</span>
                </label>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">Sign in</button>
            </div>
        </form>
    </div>

    <div class="hr-text">or</div>

    <div class="card-body">
        <form asp-controller="Account" asp-action="ExternalLogin" method="post">
            <input type="hidden" name="returnUrl" value="@Model?.ReturnUrl" />
            <div class="row g-2">
                <div class="col-6">
                    <button type="submit" name="provider" value="Google" class="btn w-100">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-2"><path d="M20.945 11a9 9 0 1 1 -3.214 -6.657" /><path d="M21 3v6h-6" /></svg>
                        Google
                    </button>
                </div>
                <div class="col-6">
                    <button type="submit" name="provider" value="Microsoft" class="btn w-100">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-2"><path d="M6 6h5v5h-5z" /><path d="M13 6h5v5h-5z" /><path d="M6 13h5v5h-5z" /><path d="M13 13h5v5h-5z" /></svg>
                        Microsoft
                    </button>
                </div>
                <div class="col-6">
                    <button type="submit" name="provider" value="GitHub" class="btn w-100">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-2"><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg>
                        GitHub
                    </button>
                </div>
                <div class="col-6">
                    <button type="submit" name="provider" value="LinkedIn" class="btn w-100">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-2"><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2.5 2.5 0 1 0 -5 0" /><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" /></svg>
                        LinkedIn
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="text-center text-secondary mt-3">
    Don't have account yet? <a asp-controller="Account" asp-action="Register" tabindex="-1">Sign up</a>
</div>
