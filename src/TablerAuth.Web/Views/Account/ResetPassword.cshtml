@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Yeni şifre belirle";
}

<div class="card card-md">
    <div class="card-body">
        <h2 class="h2 text-center mb-4">Yeni şifre belirle</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        }

        <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <label class="form-label" asp-for="Password"></label>
                <div class="input-group input-group-flat">
                    <input asp-for="Password" class="form-control" placeholder="Yeni şifre" autocomplete="new-password" />
                    <span class="input-group-text">
                        <a href="#" class="link-secondary js-password-toggle" title="Şifreyi göster" aria-label="Şifreyi göster" aria-pressed="false">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1 js-password-show"><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1 d-none js-password-hide"><path d="M10.585 10.587a2 2 0 0 0 2.829 2.83" /><path d="M16.681 16.673a8.717 8.717 0 0 1 -4.681 1.327c-3.6 0 -6.6 -2 -9 -6c1.272 -2.12 2.712 -3.678 4.32 -4.674m2.86 -1.146a9.055 9.055 0 0 1 1.82 -.18c3.6 0 6.6 2 9 6c-.666 1.11 -1.379 2.067 -2.138 2.87" /><path d="M3 3l18 18" /></svg>
                        </a>
                    </span>
                </div>
                <div class="form-hint">En az 8 karakter; büyük ve küçük harf, rakam ve özel karakter içermeli.</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Şifreyi tekrar yazın" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">Şifreyi güncelle</button>
            </div>
        </form>
    </div>
</div>

<div class="text-center text-secondary mt-3">
    <a asp-controller="Account" asp-action="Login">Girişe dön</a>
</div>
