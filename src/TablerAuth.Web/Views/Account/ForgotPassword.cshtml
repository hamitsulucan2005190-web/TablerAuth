@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Şifremi unuttum";
}

<div class="card card-md">
    <div class="card-body">
        <h2 class="h2 text-center mb-3">Şifremi unuttum</h2>
        <p class="text-secondary text-center mb-4">Hesaptaki e-posta adresini girin. Kayıtlıysa bir sonraki ekrandan devam edebilirsiniz.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="sizin@eposta.com" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">Devam et</button>
            </div>
        </form>
    </div>
</div>

<div class="text-center text-secondary mt-3">
    <a asp-controller="Account" asp-action="Login">Girişe dön</a>
</div>
